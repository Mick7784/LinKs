{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DomotiK Studio Links",
  "description": "Contenu du Linktree. Le build vérifie aussi ce fichier de façon stricte.",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "links"],
  "properties": {
    "$schema": { "type": "string" },
    "siteUrl": { "type": "string", "format": "uri" },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "avatar"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "tagline": { "type": "string" },
        "description": { "type": "string" },
        "avatar": { "$ref": "#/definitions/image" },
        "logo": { "$ref": "#/definitions/image" }
      }
    },
    "socials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "url"],
        "properties": {
          "platform": { "enum": ["youtube", "instagram", "tiktok", "discord", "x", "twitch", "github", "linkedin", "email", "website"] },
          "url": { "type": "string", "pattern": "^(https?:|mailto:|tel:)" },
          "label": { "type": "string" }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "url": { "type": "string", "pattern": "^(https?:|mailto:|tel:)" },
          "image": { "$ref": "#/definitions/image" },
          "icon": { "enum": ["youtube", "instagram", "tiktok", "discord", "mail", "website", "cart", "home"] },
          "featured": { "type": "boolean" },
          "affiliate": { "type": "boolean" },
          "expiresAt": { "type": ["string", "null"], "description": "Heure de Paris sans fuseau. Une date seule reste visible toute la journée." }
        }
      }
    }
  },
  "definitions": {
    "image": { "type": "string", "description": "Fichier de site/ ou URL http(s).", "pattern": "^(/[^/]|https?://)" }
  }
}
